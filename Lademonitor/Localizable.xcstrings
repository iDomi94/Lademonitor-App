        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Anmeldung werden deine bisherigen lokalen Daten automatisch zum Server hochgeladen. Du kannst jederzeit in den Einstellungen zurück zu \"Nur lokal\" wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After signing in, your existing local data will automatically be uploaded to the server. You can switch back to \"Local Only\" in Settings at any time."
          }
        }
      }
    },
